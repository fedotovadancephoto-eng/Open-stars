{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "alias": ["open-stars-cabinet.vercel.app"],
  "rewrites": [
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/:path*", "destination": "/index.html" },
    { "source": "/documents", "destination": "/index.html" },
    { "source": "/documents/:path*", "destination": "/index.html" }
  ]
}
